# Copy to .env.local and fill in.
# Exactly 32 random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# central (default) calls the company API; mock uses demo users without any API call.
QCHECK_AUTH=central
API_DATACENTER=http://192.168.0.248:8000
PROGRAM_CODE=PRG003
CENTRAL_AUTH_TIMEOUT_MS=5000

# Explicit development-only expansion of the central "dev" role; never honored in production.
QCHECK_ALLOW_DEV_ROLE=off
# Only needed to run QCHECK_AUTH=mock in a production demo build.
QCHECK_MOCK_AUTH=off

# SQL Server (docs/04 DEC-02). Leave DB_SERVER empty to run without a database (mock/dev).
# `npm run db:migrate` creates the database if missing and applies db/*.sql in order.
DB_SERVER=
DB_PORT=1433
DB_NAME=QCheck
DB_USER=
DB_PASSWORD=
# TLS: keep encrypt on; set DB_TRUST_CERT=on only for a self-signed dev server.
DB_ENCRYPT=on
DB_TRUST_CERT=off

# PIN login for field staff (DEC-12). At least 32 random characters; keep it out of the database.
# Changing it invalidates every stored PIN. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PIN_PEPPER=
