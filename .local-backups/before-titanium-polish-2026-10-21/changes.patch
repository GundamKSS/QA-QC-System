+
+/* Matte titanium details on the existing warm surfaces. Keep the sheen in the
+   background so Thai text, form controls and status colours stay crisp. */
+@layer components {
+  .app-theme-sand .app-topbar {
+    background-image: linear-gradient(180deg, rgb(244 240 233 / 0.055), transparent 80%);
+    box-shadow: inset 0 1px 0 rgb(244 240 233 / 0.08), 0 3px 12px rgb(0 0 0 / 0.06);
+  }
+
+  .app-theme-sand .app-panel {
+    background-image: linear-gradient(125deg, rgb(244 240 233 / 0.035), transparent 48%);
+    box-shadow: inset 0 1px 0 rgb(244 240 233 / 0.1), 0 6px 20px rgb(0 0 0 / 0.07);
+  }
+
+  .app-theme-sand .app-sidebar a[aria-current="page"] {
+    background-image: linear-gradient(110deg, rgb(244 240 233 / 0.05), transparent 75%);
+    box-shadow: inset 2px 0 0 var(--color-ember-500), inset 0 1px 0 rgb(244 240 233 / 0.06);
+  }
+
+  .app-theme-sand .app-primary-action {
+    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.13), transparent 75%);
+    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), 0 2px 6px rgb(0 0 0 / 0.12);
+    transition-property: background-color, border-color, color, box-shadow;
+    transition-duration: 150ms;
+  }
+
+  .app-theme-sand .app-primary-action:focus-visible {
+    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), 0 0 14px rgb(239 168 111 / 0.18);
+  }
+
+  .app-theme-sand .app-metal-action {
+    background-image: linear-gradient(140deg, rgb(226 216 203 / 0.09), rgb(226 216 203 / 0.015) 60%);
+    box-shadow: inset 0 1px 0 rgb(244 240 233 / 0.12);
+  }
+
+  @media (hover: hover) {
+    .app-theme-sand .app-primary-action:not(:disabled, [aria-disabled="true"]):hover {
+      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.24), 0 0 14px rgb(239 168 111 / 0.16);
+    }
+  }
+}
