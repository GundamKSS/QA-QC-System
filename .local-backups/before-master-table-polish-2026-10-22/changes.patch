+              <td><Status active={row.isActive} /></td>
+              <td><History row={row} /></td>
+              {canEdit && <td><Actions def={def} row={row} editHref={editHref(row.id)} /></td>}
+            </tr>)}</tbody>
+          </table>
+        </div>
+      </div>
+    </div>
+    <ul className="master-cards" aria-label={def.label}>
