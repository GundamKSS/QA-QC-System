+  --app-glass-background: rgb(255 249 237 / .62);
+  --app-glass-filter: blur(18px) saturate(1.6);
+}
 .app-theme-sand .app-page-area > :where(div, section, article) { animation: workspace-enter 300ms cubic-bezier(.22,1,.36,1) both; }
 @keyframes workspace-enter {
   from { opacity: 0; transform: translateY(6px); }
